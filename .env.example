# Copy to .env.local and fill in. Never commit real keys.
GOOGLE_API_KEY=your-gemini-api-key
SUPABASE_URL=https://your-project-ref.supabase.co
# The secret key (sb_secret_...). Server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key

# Optional: public-demo limits (defaults shown)
# DEMO_DAILY_LIMIT_PER_VISITOR=20
# DEMO_DAILY_LIMIT_GLOBAL=300
# IP_HASH_SALT=any-random-string
